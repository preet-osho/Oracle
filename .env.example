# ═══════════════════════════════════════
# ORACLE — Environment Variables
# Copy this file to .env.local and fill in values
# ═══════════════════════════════════════

# ─── Supabase (REQUIRED) ───────────────
# Get from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Encryption (REQUIRED for production) ──
# Used to encrypt/decrypt user API keys at rest
# Generate with: openssl rand -hex 32
# WARNING: Changing this invalidates all stored API keys
API_KEY_ENCRYPTION_KEY=

# ─── Site URL (REQUIRED for auth redirects) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Sentry (OPTIONAL - error tracking) ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Upstash Redis (OPTIONAL - production rate limiting) ──
# Without these, rate limiting falls back to in-memory (dev only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Razorpay (OPTIONAL - payment processing) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Inngest (OPTIONAL - background job queue) ──
# Without these, tasks run synchronously in the request thread
# Get from: https://app.inngest.com → Environment Settings
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
